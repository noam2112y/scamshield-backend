# Copy to .env for local testing (never commit the real .env file).

# Your Anthropic API key — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# A long random string only the app and this server know. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SHARED_TOKEN=

PORT=3000
